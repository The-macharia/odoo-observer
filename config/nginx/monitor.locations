# Written by deploy.sh and pulled into the Odoo server{} by
#   include /etc/nginx/conf.d/monitor/*.locations;
# ^~ keeps the static-asset regex locations from taking these paths. Upstreams are resolved per
# request so nginx still starts while the observer stack is down.

location = /monitor { return 301 /monitor/; }

location ^~ /monitor/ {
    resolver 127.0.0.11 valid=30s;
    set $observer_grafana observer_grafana:3000;
    proxy_pass http://$observer_grafana;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
}
